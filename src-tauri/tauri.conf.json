{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meraki Flash",
  "version": "1.0.0",
  "identifier": "com.meraki.flash",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meraki Flash",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0B0C10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "rpm",
      "nsis"
    ],
    "publisher": "Guilherme Lindner",
    "homepage": "https://github.com/merakkicode/MERAKI-FLASH",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 Guilherme Lindner",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Crie pendrives bootáveis com segurança.",
    "longDescription": "Grave imagens ISO do Windows e Linux em dispositivos USB com validações de segurança, progresso em tempo real e suporte a instalações Windows automatizadas.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "epoch": 0,
        "release": "1"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
